# Base image for the JobPulse main backend (apps/api/Dockerfile).
# Tesseract OCR and its Chinese language data are heavy (about two minutes of
# apt work) and change rarely, so they live in this separate base image and
# everyday apps/api rebuilds start from it. The compose scripts build it
# automatically before the main backend; to refresh it after editing this
# file, delete jobpulse-main-backend-base:candidate and rerun the script.
FROM python:3.11-slim

ARG DEBIAN_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian

RUN sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR_URL}|g; s|https://deb.debian.org/debian|${DEBIAN_MIRROR_URL}|g; s|http://deb.debian.org/debian-security|https://security.debian.org/debian-security|g; s|https://deb.debian.org/debian-security|https://security.debian.org/debian-security|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-chi-sim \
    && rm -rf /var/lib/apt/lists/*
