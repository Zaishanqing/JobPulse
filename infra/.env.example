# Production-parity Compose defaults. Secrets are local-only and must not be committed
# in .env; compose-common.ps1 generates replacements for local launches.
ENVIRONMENT=production
# Public download mirrors used by image builds. Override any value locally when
# a corporate proxy or artifact repository is preferred.
DEBIAN_MIRROR_URL=https://mirrors.tuna.tsinghua.edu.cn/debian
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_DEFAULT_TIMEOUT=120
PIP_RETRIES=10
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_CPU_VERSION=2.6.0+cpu
HF_ENDPOINT=https://huggingface.co
MAIN_POSTGRES_PASSWORD=jobpulse-candidate-main-password
MAIN_POSTGRES_PORT=55433
MAIN_BACKEND_JWT_SECRET_KEY=jobpulse-candidate-main-jwt-secret-0123456789
# Competition/demo only. Keep false in normal deployments.
ALLOW_DEMO_ADMIN_REGISTRATION=true
LOAD_PACKAGED_JUDGE_DATA=true
KNOWLEDGE_GRAPH_POSTGRES_PASSWORD=jobpulse-candidate-kg-password
KNOWLEDGE_GRAPH_JWT_SECRET_KEY=jobpulse-candidate-kg-jwt-secret-0123456789
KNOWLEDGE_GRAPH_SERVICE_USERNAME=integration_developer
KNOWLEDGE_GRAPH_SERVICE_PASSWORD=jobpulse-candidate-kg-service-password
EMERGING_DISCOVERY_POSTGRES_PASSWORD=jobpulse-candidate-emerging-password
EMERGING_DISCOVERY_INTERNAL_TOKEN=jobpulse-candidate-emerging-token-0123456789
EMERGING_DISCOVERY_MAINTENANCE_TOKEN=jobpulse-candidate-emerging-maintenance-0123456789
ANALYTICS_POSTGRES_ADMIN_PASSWORD=jobpulse-candidate-analytics-password
ANALYTICS_POSTGRES_PORT=55434
TREND_INTELLIGENCE_POSTGRES_PASSWORD=jobpulse-candidate-trend-password
TREND_INTELLIGENCE_INTERNAL_TOKEN=jobpulse-candidate-trend-token-0123456789
MATCHING_POSTGRES_PASSWORD=jobpulse-candidate-matching-password
MATCHING_SERVICE_SIGNING_KEY=jobpulse-candidate-matching-signing-0123456789
MATCHING_UPSTREAM_SERVICE_TOKEN=jobpulse-candidate-matching-upstream-0123456789
MATCHING_SEMANTIC_API_PUBLISHED_PORT=8011
CV_EXTRACTION_INTERNAL_TOKEN=jobpulse-candidate-cv-token-0123456789
CV_EXTRACTION_TAXONOMY_VERSION=skill-taxonomy-snapshot.v1
JD_EXTRACTION_INTERNAL_TOKEN=jobpulse-candidate-jd-token-0123456789
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CRAWLER_BASE_URL=http://crawler-api:8000
CRAWLER_INTERNAL_TOKEN=jobpulse-crawler-internal-token-0123456789abcdef
ACQUISITION_ENABLED=true
CRAWLER_CORS_ALLOWED_ORIGINS=http://localhost:53000
MAIN_BACKEND_PORT=58000
MAIN_FRONTEND_PORT=53000
JOBPULSE_IMAGE_TAG=candidate
RAG_EVIDENCE_MULTI_OBJECT_MAX_HITS=40
RAG_EVIDENCE_MULTI_OBJECT_MAX_CONTEXT_CHARS=24000
KG_GRAPH_BUILD_WORKERS=1
KG_GRAPH_BUILD_TIMEOUT_SECONDS=120
DATA_VALIDATION_MODE=enforce
# /full startup requires the extraction and acquisition profiles; default them on
# so a freshly generated .env can launch the full competition stack directly.
CV_EXTRACTION_ENABLED=true
# Responsibility CE is fail-closed in production: enabling it requires the
# verified model directory under MATCHING_RESPONSIBILITY_CE_MODEL_HOST_PATH.
MATCHING_RESPONSIBILITY_CE_MODE=enabled
MATCHING_RESPONSIBILITY_CE_MODEL_PATH=/models/responsibility-ce-v1
MATCHING_RESPONSIBILITY_CE_MANIFEST_PATH=/models/responsibility-ce-v1/manifest.json
MATCHING_RESPONSIBILITY_CE_MODEL_HOST_PATH=../models/responsibility-ce-v1
MATCHING_RESPONSIBILITY_CE_EMBEDDING_URL=http://embedding-service:8000
MATCHING_RESPONSIBILITY_CE_EMBEDDING_TIMEOUT_SECONDS=120
MATCHING_RESPONSIBILITY_CE_FALLBACK_TO_RULES=false
MATCHING_INSTALL_RESPONSIBILITY_CE=true
