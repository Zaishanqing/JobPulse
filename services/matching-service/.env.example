# Copy to .env and replace every change-me value. This file contains no real secret.
MATCHING_POSTGRES_USER=matching
MATCHING_POSTGRES_PASSWORD=change-me-local-database-password
MATCHING_POSTGRES_DB=matching
MATCHING_DATABASE_CONNECT_TIMEOUT_SECONDS=3
MATCHING_DATABASE_POOL_TIMEOUT_SECONDS=3
MATCHING_DATABASE_POOL_SIZE=5
MATCHING_DATABASE_MAX_OVERFLOW=5

MATCHING_AUTH_MODE=jwt
MATCHING_AUTH_ISSUER=https://matching.local/issuer
MATCHING_AUTH_AUDIENCE=matching-api
MATCHING_AUTH_ALGORITHMS=HS256
MATCHING_AUTH_VERIFICATION_KEY=change-me-local-signing-key-at-least-32-bytes
MATCHING_AUTH_DISCOVERY_URL=
MATCHING_AUTH_TIMEOUT_SECONDS=5
MATCHING_AUTH_JWKS_CACHE_TTL_SECONDS=300

# Generate this after choosing the signing key; never commit the generated token.
MATCHING_WORKER_TOKEN=change-me-generated-worker-jwt
MATCHING_WORKER_ID=matching-worker-compose
MATCHING_DISPATCHER_ID=matching-dispatcher-compose
MATCHING_OUTBOX_LEASE_SECONDS=30
MATCHING_OUTBOX_RETRY_INTERVAL_SECONDS=2
MATCHING_OUTBOX_IDLE_SECONDS=0.25

# Required production upstream and authorization endpoints.
MATCHING_CV_SOURCE_URL=http://cv-service:8000
MATCHING_CV_HEALTH_URL=http://cv-service:8000/health
MATCHING_POSITION_SOURCE_URL=http://position-service:8000
MATCHING_POSITION_HEALTH_URL=http://position-service:8000/health
MATCHING_GRAPH_SOURCE_URL=http://knowledge-graph:8000
MATCHING_GRAPH_HEALTH_URL=http://knowledge-graph:8000/health
MATCHING_GRAPH_VERSION=knowledge-graph.v1
MATCHING_CV_AUTHORIZATION_URL=http://cv-service:8000/api/v1/authorization/cv-owner
MATCHING_CV_AUTHORIZATION_HEALTH_URL=http://cv-service:8000/health
MATCHING_APPLICATION_GRANT_HEALTH_URL=http://application-service:8000/health
MATCHING_UPSTREAM_TIMEOUT_SECONDS=5
MATCHING_UPSTREAM_MAX_RETRIES=2
MATCHING_UPSTREAM_RETRY_BACKOFF_SECONDS=0.1
MATCHING_APPLICATION_GRANT_URL=http://application-service:8000/api/v1/authorization/application-grant
MATCHING_UPSTREAM_SERVICE_TOKEN=change-me-service-token
# Local measured demos may use authoritative HTTP profiles with memory persistence/queue.
MATCHING_UPSTREAM_PROVIDER=runtime
MATCHING_GRAPH_SOURCE_PROVIDER=runtime
MATCHING_PROFILE_CONTRACT_MAPPING_VERSION=contract-mapping.v1
MATCHING_SEMANTIC_ALGORITHM_VERSION=semantic-shadow.v1
MATCHING_SEMANTIC_THRESHOLD_VERSION=semantic-shadow-disabled.v1
MATCHING_SEMANTIC_MODE=shadow
MATCHING_SEMANTIC_WEIGHT=0
MATCHING_SEMANTIC_TOP_K=20
MATCHING_SEMANTIC_TOP_N=50
MATCHING_SEMANTIC_DISABLED_TENANT_REFS=
MATCHING_SEMANTIC_DISABLED_TARGET_TYPES=
MATCHING_DEEPSEEK_MODE=disabled
MATCHING_DEEPSEEK_MODEL=deepseek-v4-flash
MATCHING_DEEPSEEK_ALGORITHM_VERSION=deepseek-semantic-candidates.v1
MATCHING_DEEPSEEK_TIMEOUT_SECONDS=120
MATCHING_DEEPSEEK_MAX_CANDIDATES=10
MATCHING_DEEPSEEK_MIN_RELATION_CONFIDENCE=0.7
MATCHING_DEEPSEEK_MAX_CANDIDATES_PER_REQUIREMENT=3
# DeepSeek is an LLM candidate source; it never produces embeddings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MATCHING_VECTOR_INDEX_REVISION=matching_fragments_bge_m3_5617a9f_v1

MATCHING_API_PUBLISHED_PORT=8000
MATCHING_WORKER_PUBLISHED_PORT=9091
MATCHING_VECTOR_WORKER_PUBLISHED_PORT=9092
MATCHING_API_LOG_LEVEL=info
MATCHING_WORKER_LOG_LEVEL=INFO
MATCHING_API_SHUTDOWN_TIMEOUT_SECONDS=30
MATCHING_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

MATCHING_QUEUE_NAME=matching:evaluation-tasks
MATCHING_QUEUE_VISIBILITY_TIMEOUT_SECONDS=15
MATCHING_QUEUE_RETRY_INTERVAL_SECONDS=2
MATCHING_REDIS_TIMEOUT_SECONDS=3

# The standalone Compose file loads config/semantic-demo-contract.env for the
# real CPU-only BGE-M3 shadow path.
MATCHING_EMBEDDING_ENDPOINT=http://embedding-service:8000
MATCHING_VECTOR_TIMEOUT_SECONDS=5
MATCHING_VECTOR_MAX_RETRIES=2
MATCHING_VECTOR_RETRY_BACKOFF_SECONDS=0.1

# Stage B derived-vector infrastructure. The matching score path remains disabled.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_PUBLISHED_PORT=8001
QDRANT_PUBLISHED_PORT=6333
MATCHING_QDRANT_URL=http://qdrant:6333
MATCHING_QDRANT_COLLECTION=matching_fragments_bge_m3_5617a9f_v1
MATCHING_QDRANT_DIMENSION=1024
MATCHING_QDRANT_TIMEOUT_SECONDS=5
MATCHING_QDRANT_MAX_RETRIES=2
MATCHING_QDRANT_RETRY_BACKOFF_SECONDS=0.1
MATCHING_VECTOR_ADMIN_ENABLED=true
MATCHING_VECTOR_EMBEDDING_MODEL=BAAI/bge-m3
MATCHING_VECTOR_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
MATCHING_VECTOR_WORKER_ID=matching-vector-worker-compose
MATCHING_VECTOR_OUTBOX_LEASE_SECONDS=30
MATCHING_VECTOR_OUTBOX_RETRY_SECONDS=2
MATCHING_VECTOR_FRAGMENT_BATCH_SIZE=32
MATCHING_VECTOR_WORKER_EVENT_BATCH_SIZE=20
MATCHING_VECTOR_WORKER_IDLE_SECONDS=0.25
# Stage E dependencies and retrieval policy (disabled until endpoints are validated).
MATCHING_DENSE_ENABLED=true
MATCHING_SPARSE_ENABLED=false
MATCHING_SPARSE_ENDPOINT=
MATCHING_SPARSE_API_KEY=
MATCHING_SPARSE_TIMEOUT_SECONDS=5
MATCHING_DENSE_RRF_WEIGHT=0.7
MATCHING_SPARSE_RRF_WEIGHT=0.3
MATCHING_RRF_K=30
MATCHING_HYBRID_TOP_K=10
MATCHING_HYBRID_THRESHOLD=0.7
MATCHING_RERANKER_ENABLED=false
MATCHING_RERANKER_ENDPOINT=
MATCHING_RERANKER_API_KEY=
MATCHING_RERANKER_TIMEOUT_SECONDS=2
MATCHING_RERANKER_MODEL_REVISION=
MATCHING_RERANKER_TOP_K=50
MATCHING_RERANKER_TOP_N=10
MATCHING_ROLLBACK_MIN_SAMPLES=20
MATCHING_ROLLBACK_ERROR_RATE=0.05
MATCHING_ROLLBACK_LATENCY_RATE=0.10
MATCHING_ROLLBACK_EMPTY_RETRIEVAL_RATE=0.10
MATCHING_ROLLBACK_STALE_INDEX_RATE=0.01
MATCHING_ROLLBACK_HARD_CONSTRAINT_RATE=0
MATCHING_ROLLBACK_CROSS_TENANT_RATE=0
MATCHING_ROLLBACK_REDIS_URL=redis://redis:6379/0
MATCHING_ROLLBACK_REDIS_NAMESPACE=matching:feature-flags:v1
MATCHING_ROLLBACK_WINDOW_SECONDS=300
MATCHING_ROLLBACK_RECOVERY_SECONDS=3600
# Repeat for RETRIEVAL/SCORING/HYBRID/RERANKER; explicit flags are fail closed.
MATCHING_FF_INDEXING_ENABLED=false
MATCHING_FF_INDEXING_PERCENT=0
MATCHING_FF_INDEXING_TENANTS=
MATCHING_FF_INDEXING_USERS=
# Comma-separated additional non-personal technical documentation hosts.
MATCHING_PII_TECHNICAL_URL_HOSTS=


